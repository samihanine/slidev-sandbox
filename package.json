{
  "name": "markdown-slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:html": "tsc && vite build --mode html",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "check": "tsc && biome check . && vitest run && vite build --mode html",
    "audit": "bun audit --audit-level=moderate",
    "deps:outdated": "bun outdated",
    "deps:update": "bun scripts/update-deps.ts",
    "deps:update:latest": "bun scripts/update-deps.ts --latest",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide": "^1.77.0",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "hono": "4.13.18",
    "@hono/node-server": "2.1.8",
    "minimatch": "11.0.8",
    "image-size": "2.1.0"
  }
}
